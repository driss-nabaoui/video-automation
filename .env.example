# Postgres Database Credentials (Internal Docker only)
POSTGRES_USER=n8n_dbuser
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=n8n_production

# n8n Security & Encryption Key (PRESERVE PERMANENTLY)
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# Timezone Configuration
GENERIC_TIMEZONE=Africa/Casablanca
TZ=Africa/Casablanca

# Domain & Webhook Configuration
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# External APIs
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
N8N_RUNNERS_AUTH_TOKEN=

# Hollywood Cinematic AI Video Generation (Kling, Runway, Fal.ai, Luma)
AI_VIDEO_PROVIDER=auto
FAL_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=
MINIMAX_API_KEY=
